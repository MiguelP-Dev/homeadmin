package layouts

import "github.com/homeadmin/internal/templates/components"

// Base provides the HTML shell for all pages.
// email indicates authentication state: empty = not logged in, non-empty = logged in.
// isAdmin controls visibility of the Admin nav link.
// lang is the locale code ("en", "es") for i18n.
// activePath is the current request path for active link highlighting.
templ Base(title string, csrfToken string, email string, isAdmin bool, lang string, activePath string) {
	<!DOCTYPE html>
	<html lang={ lang } class="antialiased">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="/static/js/htmx.min.js"></script>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<meta name="csrf-token" content={ csrfToken }/>
			<script>
				(function() {
					var stored = localStorage.getItem('theme');
					if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen">
			@components.Nav(email, isAdmin, lang, activePath, csrfToken)
			{ children... }
			@components.ToastContainer()
		</body>
	</html>
}
