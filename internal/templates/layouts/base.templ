package layouts

import (
	assets "github.com/homeadmin"

	"github.com/homeadmin/internal/templates/components"
)

// Base provides the HTML shell for all pages.
// email indicates authentication state: empty = not logged in, non-empty = logged in.
// isAdmin controls visibility of the Admin nav link.
// lang is the locale code ("en", "es") for i18n.
// activePath is the current request path for active link highlighting.
templ Base(title string, csrfToken string, email string, isAdmin bool, lang string, activePath string) {
	<!DOCTYPE html>
	<html lang={ lang } class="antialiased">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath fill='%232563eb' d='M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3z'/%3E%3C/svg%3E"/>
			<script src={ "/static/js/htmx.min.js?v=" + assets.Version }></script>
			<link rel="stylesheet" href={ "/static/css/output.css?v=" + assets.Version }/>
			<meta name="csrf-token" content={ csrfToken }/>
			<script>
				(function() {
					var stored = localStorage.getItem('theme');
					if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen">
			@components.Nav(email, isAdmin, lang, activePath, csrfToken)
			{ children... }
			@components.ToastContainer()
		</body>
	</html>
}
