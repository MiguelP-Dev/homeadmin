package pages

import (
	"fmt"
	"time"

	"github.com/homeadmin/internal/database"
	"github.com/homeadmin/internal/i18n"
	"github.com/homeadmin/internal/services"
	"github.com/homeadmin/internal/templates/components"
)

// Dashboard renders the monthly expense summary page.
// viewerRole determines whether the Invite CTA is shown (owner/admin only).
templ Dashboard(summary *services.DashboardSummary, viewerRole string, lang string) {
	<div class="max-w-4xl mx-auto p-6">
		<div class="flex items-center justify-between mb-2">
			<h1 class="text-3xl font-bold text-gray-900">Dashboard — { fmt.Sprintf("%s %d", i18n.MonthName(lang, time.Now()), time.Now().Year()) }</h1>
			<a href="/expenses/new" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Add Expense</a>
		</div>
		if viewerRole == database.RoleOwner || viewerRole == database.RoleAdmin {
			<div class="mb-4">
				<a href="/household" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">Invite member</a>
			</div>
		}
		<div class="text-2xl font-bold text-green-700 mb-6">Monthly Total: { i18n.FormatCurrency(lang, summary.MonthlyTotal) }</div>

		<h2 class="text-xl font-semibold text-gray-800 mb-3">Category Breakdown</h2>
		<table class="w-full border-collapse mb-8">
			<thead>
				<tr class="bg-gray-100">
					<th class="text-left p-3 border-b">Category</th>
					<th class="text-left p-3 border-b">Total</th>
				</tr>
			</thead>
			<tbody>
				if len(summary.CategoryTotals) == 0 {
					<tr>
						<td colspan="2" class="p-3 text-gray-500 italic">No expenses this month</td>
					</tr>
				} else {
					for _, ct := range summary.CategoryTotals {
						<tr>
							<td class="p-3 border-b">{ i18n.CategoryLabel(lang, ct.Category) }</td>
							<td class="p-3 border-b">{ i18n.FormatCurrency(lang, ct.Total) }</td>
						</tr>
					}
				}
			</tbody>
		</table>

		<h2 class="text-xl font-semibold text-gray-800 mb-3">Recent Expenses</h2>
		if len(summary.RecentExpenses) == 0 {
			<p class="text-gray-500 italic">No recent expenses</p>
		} else {
			<div class="space-y-3">
				for _, e := range summary.RecentExpenses {
					@components.ExpenseCard(e, lang)
				}
			</div>
		}

		<p class="mt-6">
			<a href="/expenses" class="text-blue-600 hover:text-blue-800">&larr; Back to Expenses</a>
		</p>
	</div>
}
