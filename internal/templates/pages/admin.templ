package pages

import (
	"fmt"

	"github.com/homeadmin/internal/database"
)

// Admin renders the read-only site-admin page with users and households tables.
templ Admin(users []database.User, households []database.Household) {
	<div class="max-w-4xl mx-auto p-6">
		<h1 class="text-3xl font-bold text-gray-900 mb-6">Admin</h1>

		<h2 class="text-xl font-semibold text-gray-800 mb-3">Users</h2>
		<table class="w-full border-collapse mb-8">
			<thead>
				<tr class="bg-gray-100">
					<th class="text-left p-3 border-b">Email</th>
					<th class="text-left p-3 border-b">Role</th>
					<th class="text-left p-3 border-b">Is Admin</th>
					<th class="text-left p-3 border-b">Household</th>
				</tr>
			</thead>
			<tbody>
				if len(users) == 0 {
					<tr>
						<td colspan="4" class="p-3 text-gray-500 italic">No users</td>
					</tr>
				} else {
					for _, u := range users {
						<tr>
							<td class="p-3 border-b">{ u.Email }</td>
							<td class="p-3 border-b">{ u.Role }</td>
							<td class="p-3 border-b">
								if u.IsAdmin {
									<span class="text-green-700">Yes</span>
								} else {
									<span class="text-gray-500">No</span>
								}
							</td>
							<td class="p-3 border-b">
								if u.Household != nil {
									{ u.Household.Name }
								} else {
									<span class="text-gray-500">—</span>
								}
							</td>
						</tr>
					}
				}
			</tbody>
		</table>

		<h2 class="text-xl font-semibold text-gray-800 mb-3">Households</h2>
		<table class="w-full border-collapse mb-8">
			<thead>
				<tr class="bg-gray-100">
					<th class="text-left p-3 border-b">Name</th>
					<th class="text-left p-3 border-b">Members</th>
				</tr>
			</thead>
			<tbody>
				if len(households) == 0 {
					<tr>
						<td colspan="2" class="p-3 text-gray-500 italic">No households</td>
					</tr>
				} else {
					for _, h := range households {
						<tr>
							<td class="p-3 border-b">{ h.Name }</td>
							<td class="p-3 border-b">{ fmt.Sprintf("%d", len(h.Members)) }</td>
						</tr>
					}
				}
			</tbody>
		</table>

		<p class="mt-6">
			<a href="/dashboard" class="text-blue-600 hover:text-blue-800">&larr; Back to Dashboard</a>
		</p>
	</div>
}
