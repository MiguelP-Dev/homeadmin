package pages

import (
	"fmt"

	"github.com/homeadmin/internal/database"
	"github.com/homeadmin/internal/i18n"
	"github.com/homeadmin/internal/services"
)

// Admin renders the read-only site-admin page with a site summary, users
// table, and per-household overview rows linking to the global views.
templ Admin(users []database.User, summary *services.AdminSummary, lang string) {
	<div class="max-w-4xl mx-auto p-6">
	<h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">{ i18n.T(lang, "nav.admin") }</h1>

	<!-- Site Summary -->
	<h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-3">{ i18n.T(lang, "admin.summary") }</h2>
		<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
			<div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow border-l-4 border-gray-500">
				<div class="text-sm font-medium text-gray-700 dark:text-gray-300">{ i18n.T(lang, "admin.count_households") }</div>
				<div class="text-2xl font-bold text-gray-900 dark:text-white">{ fmt.Sprintf("%d", summary.Households) }</div>
			</div>
			<div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow border-l-4 border-gray-500">
				<div class="text-sm font-medium text-gray-700 dark:text-gray-300">{ i18n.T(lang, "admin.count_users") }</div>
				<div class="text-2xl font-bold text-gray-900 dark:text-white">{ fmt.Sprintf("%d", summary.Users) }</div>
			</div>
			<div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow border-l-4 border-blue-500">
				<div class="text-sm font-medium text-gray-700 dark:text-gray-300">{ i18n.T(lang, "admin.count_transactions") }</div>
				<div class="text-2xl font-bold text-blue-600 dark:text-blue-400">{ fmt.Sprintf("%d", summary.Transactions) }</div>
			</div>
			<div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow border-l-4 border-green-500">
				<div class="text-sm font-medium text-gray-700 dark:text-gray-300">{ i18n.T(lang, "total_income") }</div>
				<div class="text-2xl font-bold text-green-600 dark:text-green-400">{ i18n.FormatCurrency(lang, summary.TotalIncome) }</div>
			</div>
			<div class="bg-white dark:bg-gray-800 p-4 rounded-lg shadow border-l-4 border-emerald-500">
				<div class="text-sm font-medium text-gray-700 dark:text-gray-300">{ i18n.T(lang, "savings.total") }</div>
				<div class="text-2xl font-bold text-emerald-600 dark:text-emerald-400">{ i18n.FormatCurrency(lang, summary.TotalSavings) }</div>
			</div>
		</div>

		<h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-3">{ i18n.T(lang, "admin.count_users") }</h2>
		<table class="w-full border-collapse mb-8">
			<thead>
				<tr class="bg-gray-100 dark:bg-gray-700">
					<th class="text-left p-3 border-b">{ i18n.T(lang, "table.email") }</th>
					<th class="text-left p-3 border-b">{ i18n.T(lang, "table.role") }</th>
					<th class="text-left p-3 border-b">{ i18n.T(lang, "table.is_admin") }</th>
					<th class="text-left p-3 border-b">{ i18n.T(lang, "admin.household") }</th>
				</tr>
			</thead>
			<tbody>
				if len(users) == 0 {
					<tr>
						<td colspan="4" class="p-3 text-gray-500 italic">{ i18n.T(lang, "admin.no_users") }</td>
					</tr>
				} else {
					for _, u := range users {
						<tr>
							<td class="p-3 border-b">{ u.Email }</td>
							<td class="p-3 border-b">{ i18n.T(lang, "household.role."+u.Role) }</td>
							<td class="p-3 border-b">
								if u.IsAdmin {
									<span class="text-green-700 dark:text-green-400">{ i18n.T(lang, "common.yes") }</span>
								} else {
									<span class="text-gray-500">{ i18n.T(lang, "common.no") }</span>
								}
							</td>
							<td class="p-3 border-b">
								if u.Household != nil {
									{ u.Household.Name }
								} else {
									<span class="text-gray-500">—</span>
								}
							</td>
						</tr>
					}
				}
			</tbody>
		</table>

		<h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-3">{ i18n.T(lang, "admin.count_households") }</h2>
		<table class="w-full border-collapse mb-8">
			<thead>
				<tr class="bg-gray-100 dark:bg-gray-700">
					<th class="text-left p-3 border-b">{ i18n.T(lang, "admin.household") }</th>
					<th class="text-left p-3 border-b">{ i18n.T(lang, "admin.members") }</th>
					<th class="text-right p-3 border-b">{ i18n.T(lang, "admin.monthly_net") }</th>
					<th class="text-left p-3 border-b">{ i18n.T(lang, "admin.open") }</th>
				</tr>
			</thead>
			<tbody>
				if len(summary.Rows) == 0 {
					<tr>
						<td colspan="4" class="p-3 text-gray-500 italic">{ i18n.T(lang, "admin.no_households") }</td>
					</tr>
				} else {
					for _, row := range summary.Rows {
						<tr>
							<td class="p-3 border-b font-medium">{ row.Name }</td>
							<td class="p-3 border-b">{ fmt.Sprintf("%d", row.Members) }</td>
							<td class={ "p-3 border-b text-right font-semibold " + monthlyNetClass(row.MonthlyNet) }>{ i18n.FormatCurrency(lang, row.MonthlyNet) }</td>
							<td class="p-3 border-b space-x-3 whitespace-nowrap">
								<a href="/dashboard" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">{ i18n.T(lang, "nav.dashboard") }</a>
								<a href="/expenses" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">{ i18n.T(lang, "nav.expenses") }</a>
								<a href="/savings" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">{ i18n.T(lang, "nav.savings") }</a>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>

		<p class="mt-6">
			<a href="/dashboard" class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">&larr; { i18n.T(lang, "admin.back_to_dashboard") }</a>
		</p>
	</div>
}
