package pages

import (
	"github.com/homeadmin/internal/database"
	"github.com/homeadmin/internal/i18n"
)

// ExpenseForm renders the create or edit expense form. formAction is the POST
// target (/expenses for create, /expenses/:id/update for edit), submitLabel is
// the heading and button text, and errorMsg is shown above the form when
// non-empty.
templ ExpenseForm(csrfToken string, formAction string, submitLabel string, errorMsg string, values ExpenseFormValues, lang string) {
	<div class="max-w-md mx-auto mt-10 p-6 bg-white dark:bg-gray-800 rounded shadow">
		<h1 class="text-2xl font-bold mb-4">{ submitLabel }</h1>
		if errorMsg != "" {
			<p class="text-red-500 dark:text-red-400 mb-4">{ errorMsg }</p>
		}
		<form method="POST" action={ formAction }>
			<input type="hidden" name="csrf" value={ csrfToken }/>
			<div class="mb-4">
				<label class="block text-sm font-medium text-gray-900 dark:text-gray-100 mb-2">{ i18n.T(lang, "type") }:</label>
				<div class="flex gap-4">
					<label class="flex items-center">
						<input type="radio" name="type" value="expense" checked={ values.Type == "expense" || values.Type == "" } class="mr-1"/>
						<span class="text-sm text-gray-900 dark:text-gray-100">{ i18n.T(lang, "expense") }</span>
					</label>
					<label class="flex items-center">
						<input type="radio" name="type" value="income" checked={ values.Type == "income" } class="mr-1"/>
						<span class="text-sm text-gray-900 dark:text-gray-100">{ i18n.T(lang, "income") }</span>
					</label>
				</div>
			</div>
			<div class="mb-4">
				<label for="description" class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "table.description") }:</label>
				<input type="text" id="description" name="description" required class="w-full border rounded p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" value={ values.Description }/>
			</div>
			<div class="mb-4">
				<label for="amount" class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "table.amount") }:</label>
				<input type="number" step="0.01" min="0" id="amount" name="amount" required class="w-full border rounded p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" value={ values.Amount }/>
			</div>
			<div class="mb-4">
				<label for="category" class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "table.category") }:</label>
				<select id="category" name="category" required class="w-full border rounded p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
					for _, cat := range database.ExpenseCategories {
						<option value={ cat } data-type="expense" class="cat-option" selected={ values.Category == cat }>{ i18n.CategoryLabel(lang, cat) }</option>
					}
					for _, cat := range database.IncomeCategories {
						<option value={ cat } data-type="income" class="cat-option" style="display:none" selected={ values.Category == cat }>{ i18n.CategoryLabel(lang, cat) }</option>
					}
				</select>
			</div>
			<div class="mb-4">
				<label for="date" class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "table.date") }:</label>
				<input type="date" id="date" name="date" class="w-full border rounded p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" value={ values.Date }/>
			</div>
			<div class="mb-4">
				<label for="visibility" class="block text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "expense.visibility") }:</label>
				<select id="visibility" name="visibility" class="w-full border rounded p-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
					<option value="visible_editable" selected={ values.Visibility == database.VisibleEditable || values.Visibility == "" }>{ i18n.T(lang, "visibility.visible_editable") }</option>
					<option value="visible_only" selected={ values.Visibility == database.VisibleOnly }>{ i18n.T(lang, "visibility.visible_only") }</option>
					<option value="hidden_private" selected={ values.Visibility == database.HiddenPrivate }>{ i18n.T(lang, "visibility.hidden_private") }</option>
				</select>
			</div>
			<div class="mb-4">
				<label for="isFixed" class="flex items-center">
					<input type="checkbox" id="isFixed" name="isFixed" value="true" checked={ values.IsFixed } class="mr-2"/>
					<span class="text-sm font-medium text-gray-900 dark:text-gray-100">{ i18n.T(lang, "expense.fixed_expense") }</span>
				</label>
			</div>
			<button type="submit" class="w-full bg-blue-500 text-white p-2 rounded hover:bg-blue-600">{ submitLabel }</button>
		</form>
		<p class="mt-4 text-sm"><a href="/expenses" class="text-blue-500">&larr; { i18n.T(lang, "common.back_to_expenses") }</a></p>
		<script>
			(function() {
				var radios = document.querySelectorAll('input[name="type"]');
				var opts = document.querySelectorAll('.cat-option');
				var sel = document.getElementById('category');
				function updateCats() {
					var type = document.querySelector('input[name="type"]:checked').value;
					var prev = sel.value;
					var found = false;
					for (var i = 0; i < opts.length; i++) {
						if (opts[i].dataset.type === type) {
							opts[i].style.display = '';
							if (opts[i].value === prev) found = true;
						} else {
							opts[i].style.display = 'none';
						}
					}
					if (!found) {
						for (var i = 0; i < opts.length; i++) {
							if (opts[i].dataset.type === type) { sel.value = opts[i].value; break; }
						}
					}
				}
				for (var i = 0; i < radios.length; i++) {
					radios[i].addEventListener('change', updateCats);
				}
				updateCats();
			})();
		</script>
	</div>
}
